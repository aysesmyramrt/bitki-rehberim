<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.bitkirehberim">

    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BitkiRehberim">

        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"/>

        <activity
            android:name=".CategoryActivity"
            android:parentActivityName=".MainActivity"
            android:label="Kategori"
            android:exported="true"/>

        <activity
            android:name=".PlantDetailActivity"
            android:parentActivityName=".CategoryActivity"
            android:label="Bitki Detayı"
            android:exported="true"/>

        <activity
            android:name=".SeasonalActivity"
            android:exported="false" />

        <activity
            android:name=".MedicinalPlantsActivity"
            android:exported="false"
            android:label="Şifalı Bitkiler"
            android:parentActivityName=".MainActivity"/>

        <activity
            android:name=".MedicinalPlantDetailActivity"
            android:exported="false"
            android:parentActivityName=".MedicinalPlantsActivity"/>

    </application>
</manifest>

